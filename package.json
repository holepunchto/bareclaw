{
  "name": "bareclaw",
  "version": "0.1.1",
  "description": "Bare library exposing picoclaw AI agent via RPC",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "scripts": {
    "format": "prettier . --write",
    "test": "brittle-bare test/index.js",
    "lint": "prettier . --check && lunte",
    "build": "make build"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "assets",
    "prebuilds"
  ],
  "imports": {
    "#bareclaw": {
      "darwin": {
        "arm64": "./prebuilds/darwin-arm64/bareclaw",
        "x64": "./prebuilds/darwin-x64/bareclaw"
      },
      "linux": {
        "arm64": "./prebuilds/linux-arm64/bareclaw",
        "x64": "./prebuilds/linux-x64/bareclaw"
      },
      "win32": {
        "arm64": "./prebuilds/win32-arm64/bareclaw.exe",
        "x64": "./prebuilds/win32-x64/bareclaw.exe"
      }
    }
  },
  "dependencies": {
    "b4a": "^1.8.1",
    "bare-events": "^2.5.0",
    "bare-fs": "^4.7.2",
    "bare-rpc": "^1.3.2",
    "bare-subprocess": "^6.1.0",
    "compact-encoding": "^3.2.0",
    "hyperbee2": "^2.10.2",
    "ready-resource": "^1.2.0",
    "require-asset": "^1.2.2"
  },
  "devDependencies": {
    "bare-path": "^3.0.1",
    "bare-process": "^4.4.1",
    "bare-tui": "^0.0.1",
    "brittle": "^4.0.0",
    "corestore": "^7.10.1",
    "hyperdht": "^6.32.0",
    "hyperswarm": "^4.17.0",
    "lunte": "^1.8.0",
    "prettier": "^3.8.3",
    "prettier-config-holepunch": "^2.0.0",
    "test-tmp": "^1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/bareclaw.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bareclaw/issues"
  },
  "homepage": "https://github.com/holepunchto/bareclaw"
}
