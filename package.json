{
  "name": "bareclaw",
  "version": "0.1.0",
  "description": "Bare library exposing picoclaw AI agent via RPC",
  "main": "index.js",
  "scripts": {
    "test": "brittle-bare test/all.mjs",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "build": "make build"
  },
  "files": [
    "index.js",
    "lib",
    "assets",
    "prebuilds"
  ],
  "imports": {
    "#bareclaw": {
      "darwin": {
        "arm64": "./prebuilds/darwin-arm64/bareclaw",
        "x64": "./prebuilds/darwin-x64/bareclaw"
      },
      "linux": {
        "arm64": "./prebuilds/linux-arm64/bareclaw",
        "x64": "./prebuilds/linux-x64/bareclaw"
      },
      "win32": {
        "arm64": "./prebuilds/win32-arm64/bareclaw.exe",
        "x64": "./prebuilds/win32-x64/bareclaw.exe"
      }
    }
  },
  "dependencies": {
    "bare-events": "^2.5.0",
    "b4a": "^1.8.1",
    "bare-fs": "^4.7.2",
    "bare-rpc": "^1.3.2",
    "bare-subprocess": "^6.1.0",
    "compact-encoding": "^3.2.0",
    "hyperbee2": "^2.10.2",
    "ready-resource": "^1.2.0",
    "require-asset": "^1.2.2"
  },
  "devDependencies": {
    "bare-process": "^4.4.1",
    "brittle": "^4.0.0",
    "corestore": "^7.10.1",
    "prettier": "^3.8.3",
    "prettier-config-holepunch": "^2.0.0",
    "test-tmp": "^1.4.0"
  }
}
